# direnv: auto-activate project venv when you enter this directory
# Install: brew install direnv
# Shell: eval "$(direnv hook zsh)"  # once in ~/.zshrc
# Then: direnv allow
#
# If .venv is missing, run: bash tools/setup_venv.sh

if [[ -f .venv/bin/activate ]]; then
  source .venv/bin/activate
  export VIRTUAL_ENV_DISABLE_PROMPT="${VIRTUAL_ENV_DISABLE_PROMPT:-}"
  PATH_add .venv/bin
elif [[ -d .venv ]]; then
  PATH_add .venv/bin
fi

# Prefer project tools
export PYTHONPATH="${PWD}${PYTHONPATH:+:$PYTHONPATH}"
