{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://cdmj.local/spec-v3/contracts/common_contracts.schema.json",
  "title":"CDMJ Common Contracts 1.0.0",
  "type":"object","additionalProperties":false,
  "required":["contract_version","payload_type","payload"],
  "properties":{"contract_version":{"const":"CDMJ-CONTRACTS 1.0.0"},"payload_type":{"enum":["game_state","player_view","legal_action_set","decision_result","audit_record","parameter_definition","seed_trace"]},"payload":{"type":"object"}},
  "$defs":{
    "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "seat":{"type":"integer","minimum":0,"maximum":3},
    "face_id":{"type":"string","pattern":"^(wan|tong|tiao)_[1-9]$"},
    "physical_id":{"type":"integer","minimum":0,"maximum":107},
    "physical_tile":{"type":"object","additionalProperties":false,"required":["tile_id","face_id","copy_index"],"properties":{"tile_id":{"$ref":"#/$defs/physical_id"},"face_id":{"$ref":"#/$defs/face_id"},"copy_index":{"type":"integer","minimum":0,"maximum":3}}},
    "discard":{"type":"object","additionalProperties":false,"required":["event_index","seat","tile_id","claimed_by","claim_kind"],"properties":{"event_index":{"type":"integer","minimum":0},"seat":{"$ref":"#/$defs/seat"},"tile_id":{"$ref":"#/$defs/physical_id"},"claimed_by":{"oneOf":[{"$ref":"#/$defs/seat"},{"type":"null"}]},"claim_kind":{"type":["string","null"]}}},
    "meld":{"type":"object","additionalProperties":false,"required":["kind","tile_ids","source_seat","claimed_discard_event"],"properties":{"kind":{"enum":["pong","ming_gang","an_gang","jia_gang"]},"tile_ids":{"type":"array","minItems":3,"maxItems":4,"uniqueItems":true,"items":{"$ref":"#/$defs/physical_id"}},"source_seat":{"oneOf":[{"$ref":"#/$defs/seat"},{"type":"null"}]},"claimed_discard_event":{"type":["integer","null"],"minimum":0}}},
    "player":{"type":"object","additionalProperties":false,"required":["seat","concealed_tile_ids","score","is_dealer","dingque","melds","discards","status","hu_order","last_win"],"properties":{"seat":{"$ref":"#/$defs/seat"},"concealed_tile_ids":{"type":"array","maxItems":14,"uniqueItems":true,"items":{"$ref":"#/$defs/physical_id"}},"score":{"type":"integer","minimum":-9223372036854775808,"maximum":9223372036854775807},"is_dealer":{"type":"boolean"},"dingque":{"enum":["wan","tong","tiao",null]},"melds":{"type":"array","items":{"$ref":"#/$defs/meld"}},"discards":{"type":"array","items":{"$ref":"#/$defs/discard"}},"status":{"enum":["active","finished"]},"hu_order":{"type":["integer","null"],"minimum":1,"maximum":4},"last_win":{"type":["object","null"]}}},
    "action":{"type":"object","additionalProperties":false,"required":["type"],"properties":{"type":{"enum":["exchange","dingque","discard","pass","pong","gang_ming","gang_an","gang_jia","hu"]},"tiles":{"type":"array","default":[],"items":{"$ref":"#/$defs/face_id"}},"suit":{"enum":["wan","tong","tiao",null],"default":null}}},
    "candidate":{"type":"object","additionalProperties":false,"required":["candidate_key","action","mandatory","generated_by","legal","filtered_reason"],"properties":{"candidate_key":{"type":"string","minLength":1},"action":{"$ref":"#/$defs/action"},"mandatory":{"type":"boolean","default":false},"generated_by":{"type":"string","pattern":"^(RULE|ALGO|HEUR|MODEL|STATE|SCORE|TRAIN|AUDIT)-[0-9]{3}$"},"legal":{"const":true},"filtered_reason":{"type":["string","null"],"default":null}}},
    "score_breakdown":{"type":"object","additionalProperties":false,"required":["raw_features","missing_mask","weights","components","corrections","final_score","rank"],"properties":{"raw_features":{"type":"object","additionalProperties":{"type":"number"}},"missing_mask":{"type":"object","additionalProperties":{"type":"boolean"}},"weights":{"type":"object","additionalProperties":{"type":"number","minimum":-2,"maximum":2}},"components":{"type":"object","additionalProperties":{"type":"number"}},"corrections":{"type":"object","additionalProperties":false,"required":["style","level","phase","noise"],"properties":{"style":{"type":"number","minimum":-0.3,"maximum":0.3},"level":{"type":"number","minimum":-1,"maximum":1},"phase":{"type":"number","minimum":-0.25,"maximum":0.25},"noise":{"type":"number","minimum":-0.1,"maximum":0.1}}},"final_score":{"type":"number","minimum":-4,"maximum":4,"multipleOf":0.00000001},"rank":{"type":"integer","minimum":1}}},
    "seed_trace":{"type":"object","additionalProperties":false,"required":["game_id","algorithm_version","master_seed","stream_name","index_before","index_after","seed_hash"],"properties":{"game_id":{"type":"string","minLength":1,"maxLength":256},"algorithm_version":{"type":"string","minLength":1},"master_seed":{"type":"integer","minimum":0},"stream_name":{"type":["string","null"]},"index_before":{"type":"integer","minimum":0},"index_after":{"type":"integer","minimum":0},"seed_hash":{"$ref":"#/$defs/sha256"}}},
    "decision_explanation":{"type":"object","additionalProperties":false,"required":["generated_candidates","scored_candidates","filtered_candidates","selected_candidate_key","selection_reason","abandoned_reasons","stop_reason","plan","attention","belief_summary","rng_used","rng_index_before","rng_index_after"],"properties":{"generated_candidates":{"type":"array","items":{"$ref":"#/$defs/candidate"}},"scored_candidates":{"type":"array","items":{"$ref":"#/$defs/score_breakdown"}},"filtered_candidates":{"type":"array"},"selected_candidate_key":{"type":["string","null"]},"selection_reason":{"type":["string","null"]},"abandoned_reasons":{"type":"object"},"stop_reason":{"type":["string","null"]},"plan":{"type":["object","null"]},"attention":{"type":"array"},"belief_summary":{"type":["object","null"]},"rng_used":{"type":"boolean"},"rng_index_before":{"type":"integer","minimum":0},"rng_index_after":{"type":"integer","minimum":0}}}
  }
}
