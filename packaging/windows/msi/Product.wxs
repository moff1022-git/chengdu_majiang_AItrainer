<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX 3.x product skeleton for Chengdu Mahjong AI Trainer (F0027).
  Built by tools/packaging/build_msi_windows.ps1 with candle -dProductVersion=… -dProductName=…
  App file components come from heat-generated AppFiles.wxs (ComponentGroup AppFiles).
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <!-- UpgradeCode: stable product line id (do not change across versions) -->
  <Product
      Id="*"
      Name="$(var.ProductNameZh)"
      Language="2052"
      Codepage="65001"
      Version="$(var.ProductVersion)"
      Manufacturer="$(var.Manufacturer)"
      UpgradeCode="A7B3C1D2-E4F5-6789-ABCD-EF0123456789">

    <Package
        InstallerVersion="500"
        Compressed="yes"
        InstallScope="perMachine"
        Platform="x64"
        Description="$(var.ProductNameZh) $(var.ProductVersion)"
        Comments="Chengdu Mahjong AI Trainer — Windows x64 MSI (F0027)"
        Manufacturer="$(var.Manufacturer)" />

    <MajorUpgrade
        DowngradeErrorMessage="已安装更新的版本，无法降级安装。"
        Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Feature Id="MainFeature" Title="$(var.ProductNameZh)" Level="1"
             Description="主程序、资源与座位窗依赖（PyInstaller onedir）">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="ChengduMahjongAITrainer" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="成都麻将AI训练器" />
      </Directory>
    </Directory>

    <!-- Start menu shortcut; registry keypath for the component -->
    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="StartMenuShortcut" Guid="B8C4D2E3-F5A6-7890-BCDE-F12345678901">
        <Shortcut
            Id="MainStartMenuShortcut"
            Name="成都麻将AI训练器"
            Description="成都麻将 AI 训练器"
            Target="[INSTALLDIR]ChengduMahjongAITrainer.exe"
            WorkingDirectory="INSTALLDIR"
            Advertise="no" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
        <!-- ICE38/43: start-menu component keypath under HKCU -->
        <RegistryValue
            Root="HKCU"
            Key="Software\ChengduMahjongAITrainer"
            Name="StartMenuShortcut"
            Type="integer"
            Value="1"
            KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- ARP display -->
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/moff1022-git/chengdu_majiang_AItrainer" />
    <Property Id="ARPHELPLINK" Value="https://github.com/moff1022-git/chengdu_majiang_AItrainer/releases" />
  </Product>
</Wix>
